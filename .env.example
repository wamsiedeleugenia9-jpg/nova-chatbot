# Browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side privileged Supabase access (never expose this key to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side only API credentials and Stripe resource identifiers
ANTHROPIC_API_KEY=your-anthropic-api-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
STRIPE_FOUNDER_PRICE_ID=price_your-founder-price-id
