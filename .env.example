# Browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional server-side Supabase URL override. Server integrations fall back to
# NEXT_PUBLIC_SUPABASE_URL because the project URL is not a credential.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side privileged Supabase access (never expose this key to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side only API credentials and Stripe resource identifiers
ANTHROPIC_API_KEY=your-anthropic-api-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
STRIPE_FOUNDER_PRICE_ID=price_your-founder-price-id
# Long random bearer secret for POST /api/stripe/reconcile
STRIPE_RECONCILIATION_SECRET=your-random-reconciliation-secret

# Canonical browser origin used for Stripe redirects (HTTPS except local development)
EWA_APP_ORIGIN=https://your-production-domain.example
